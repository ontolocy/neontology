# Copy to .env and fill in. Both neontology itself (via python-dotenv) and
# docker-compose.yml read this file.
#
# Ports below match docker-compose.yml:
#   neo4j        bolt 7687   testneo4j     bolt 8687
#   memgraph     bolt 9686   testmemgraph  bolt 9687 (same port CI publishes)


# --- Application connection ---------------------------------------------
# Read by Neo4jConfig / MemgraphConfig when you don't pass values explicitly.
# init_neontology() with no config defaults to Neo4j; set NEONTOLOGY_ENGINE to
# NEO4J, MEMGRAPH or NETWORKX to pick a different default.

NEONTOLOGY_ENGINE=NEO4J

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<password>

# NB: MEMGRAPH_USERNAME here, but TEST_MEMGRAPH_USER below - the library and the
# test fixture spell this differently. docker-compose.yml maps both onto the
# MEMGRAPH_USER variable the image itself expects.
MEMGRAPH_URI=bolt://localhost:9686
MEMGRAPH_USERNAME=memgraphuser
MEMGRAPH_PASSWORD=<password>


# --- Test connection ----------------------------------------------------
# Read by tests/conftest.py. The session fixture asserts every one of these is
# set, so a missing memgraph value fails the neo4j runs too - run a subset with
# `pytest -k 'neo4j-engine'`, or skip the database entirely with
# `pytest -m "not uses_graph"`. The networkx engine needs no configuration.

TEST_NEO4J_URI=bolt://localhost:8687
TEST_NEO4J_USERNAME=neo4j
TEST_NEO4J_PASSWORD=<password>

TEST_MEMGRAPH_URI=bolt://localhost:9687
TEST_MEMGRAPH_USER=memgraphuser
TEST_MEMGRAPH_PASSWORD=<password>


# --- Container startup --------------------------------------------------
# Only used by docker-compose.yml to seed credentials on first start. The neo4j
# image takes a single user/password pair; these must agree with the values
# above. The memgraph services derive their credentials from the variables
# already set above, so they need nothing extra here.

NEO4J_AUTH=neo4j/<password>
TEST_NEO4J_AUTH=neo4j/<password>
